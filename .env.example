# Leap+ configuration.
# Copy to .env (`cp .env.example .env`) and fill in values. .env is git-ignored.
# Every key stays on the server; none is ever sent to the browser.
# Leave a value empty if you don't have it yet: the matching feature is shown as unavailable.

# --- App -------------------------------------------------------------------
# Where the app runs. Stripe redirects back here after Checkout.
APP_BASE_URL=http://localhost:8000
# SQLite file, relative to the project folder.
DATABASE_PATH=data/leapplus.db

# --- Stage 1: Stripe (SANDBOX ONLY) ----------------------------------------
# Stripe Dashboard (sandbox / test mode) -> Developers -> API keys -> Secret key.
# Must start with sk_test_. The app refuses to start with a live key.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to ...` when it starts. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# --- Stage 2: NTA GTFS-Realtime --------------------------------------------
# developer.nationaltransport.ie -> subscribe to product "GTFS Realtime" -> Primary key.
# Sent server-side in the `x-api-key` header.
NTA_API_KEY=

# --- Stage 5: OpenRouter (Ask Leap) ----------------------------------------
# openrouter.ai -> Keys -> Create key.
OPENROUTER_API_KEY=
# Model slug, chosen in Stage 5 after checking it supports tool calling.
OPENROUTER_MODEL=
